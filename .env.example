# ==========================================
# Telegram Bot Music
# Created by FacuSecX
# https://github.com/FacuSecX/
# ==========================================

BOT_TOKEN=TOKEN_DE_BOTFATHER
ALLOWED_USER_IDS=TU_ID_DE_TELEGRAM
DATA_DIR=data
MAX_DURATION=1200

# Opcional: archivo de sesión Netscape privado, creado y autorizado por el propietario.
# YOUTUBE_COOKIE_FILE=/home/debian/music-bot/data/youtube-cookies.txt
# YOUTUBE_PLAYER_CLIENT=web

# Opcional: salida de red solo para obtener audios; las búsquedas siguen directas.
# YOUTUBE_PROXY=socks5h://127.0.0.1:40000

# Recuperación limitada del proxy WARP local ante una verificación general.
# YOUTUBE_WARP_RECOVERY=1

# M4A original evita la conversión; MP3 a 192 kbps queda como alternativa.
# Usar mp3 para exigir siempre MP3.
AUDIO_FORMAT=m4a

# Caché de audio limitada para repetir envíos sin volver a YouTube.
AUDIO_CACHE_DIR=data/audio-cache
AUDIO_CACHE_MB=512
AUDIO_CACHE_DAYS=7
MESSAGE_TTL_SECONDS=90
